{
  "name": "ecg-lab-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:all": "pnpm test && pnpm typecheck && pnpm build && pnpm test:e2e",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "vitest": "latest"
  }
}
